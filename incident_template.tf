# What an incident from the route looks like. Severity comes from the
# Service's Tier through var.tier_severity.

locals {
  service_tier = "alert.attributes.${incident_alert_attribute.service.id}.catalog_attribute[\"${incident_catalog_type_attribute.service_tier.id}\"]"
}

resource "incident_incident_template" "alert_incident" {
  name = var.incident_template_name

  expressions = [{
    label          = "Severity from Service tier"
    reference      = "sevtier1"
    root_reference = "alert"
    operations = [{
      operation_type = "branches"
      branches = {
        returns = { type = "IncidentSeverity", array = false }
        branches = [for b in var.tier_severity : {
          condition_groups = [{
            conditions = [{
              subject        = local.service_tier
              operation      = "equals"
              param_bindings = [{ value = { literal = b.tier } }]
            }]
          }]
          result = { value = { literal = data.incident_severity.by_name[b.severity].id } }
        }]
      }
    }]
    else_branch = {
      result = { value = { literal = data.incident_severity.by_name[var.default_severity].id } }
    }
  }]

  template = {
    # Written as raw JSON: jsonencode() would escape "->" and cause a diff.
    name = {
      autogenerated = false
      value         = { literal = file("${path.module}/templates/incident_name.json") }
    }
    summary = {
      autogenerated = false
      value = {
        literal = templatefile("${path.module}/templates/incident_summary.json.tftpl", {
          runbook_attribute_id = incident_alert_attribute.runbook.id
        })
      }
    }

    severity = {
      binding        = { value = { reference = "expressions[\"sevtier1\"]" } }
      merge_strategy = "max"
    }

    start_in_triage = { value = { literal = "true" } }

    custom_fields = [for f in data.incident_custom_field.affected_teams : {
      custom_field_id = f.id
      merge_strategy  = "append"
      binding = {
        array_value = [{ reference = "alert.attributes.${data.incident_alert_attribute.team.id}" }]
      }
    }]
  }
}
